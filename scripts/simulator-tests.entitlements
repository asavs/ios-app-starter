<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The simulator Keychain refuses (errSecMissingEntitlement, -34018) an app with no application
	     identifier, which an unsigned or team-less simulator build has. scripts/test-ios.sh signs the
	     app ad hoc with this file so the Settings module's Keychain path runs for real in UI tests.
	     Device and release builds get the same entitlement from the provisioning profile instead. -->
	<key>application-identifier</key>
	<string>$(AppIdentifierPrefix)$(CFBundleIdentifier)</string>
</dict>
</plist>
